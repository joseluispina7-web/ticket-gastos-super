# Runtime variable configured in Sites. Never commit the real value.
INVITE_CODE=replace-with-a-private-invite-code

# Short-lived credentials generated by Sites for one source push.
SITES_REMOTE_URL=
SITES_TOKEN=

# GitHub repository secrets used by .github/workflows/deploy-cloudflare.yml.
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_D1_DATABASE_ID=
